{
  "name": "agent-eval",
  "version": "0.1.0",
  "description": "Agent evaluation tool using UX research methods",
  "author": "Riley Benson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jrbenson/agent-eval.git"
  },
  "scripts": {
    "dev": "concurrently \"bun run dev:hmr\" \"bun run dev:electrobun\"",
    "dev:electrobun": "electrobun dev --watch",
    "dev:hmr": "vite --port 5173",
    "build": "vite build && electrobun build --env=stable",
    "build:canary": "vite build && electrobun build --env=canary",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:functional": "bun test src/testing/functional",
    "check": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.68",
    "@ai-sdk/azure": "^3.0.53",
    "@ai-sdk/google": "^3.0.60",
    "@ai-sdk/groq": "^3.0.35",
    "@ai-sdk/mistral": "^3.0.30",
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/xai": "^3.0.82",
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "@faker-js/faker": "^10.4.0",
    "@floating-ui/react": "^0.27.19",
    "@tanstack/react-query": "^5.96.2",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "ace-builds": "^1.43.6",
    "ai": "^6.0.154",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "electrobun": "1.16.0",
    "next-themes": "^0.4.6",
    "randexp": "^0.5.3",
    "react": "^18.3.1",
    "react-ace": "^14.0.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "zod": "^4.3.6",
    "zod-schema-faker": "^2.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "happy-dom": "^16.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.0.0"
  }
}
